{
  "name": "tangie",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "prebuild": "tsx scripts/check-no-wix.ts && tsx scripts/check-sections.ts",
    "check:wix": "tsx scripts/check-no-wix.ts",
    "check:wix:prod": "tsx scripts/check-no-wix.ts --require-db",
    "hash-password": "tsx scripts/hash-password.ts",
    "check:sections": "tsx scripts/check-sections.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1151.0",
    "@aws-sdk/lib-storage": "3.1151.0",
    "@aws-sdk/s3-request-presigner": "3.1151.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@getbrevo/brevo": "6.1.0",
    "@marsidev/react-turnstile": "1.6.2",
    "@tailwindcss/typography": "0.5.20",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "file-type": "22.1.1",
    "jose": "6.2.12",
    "marked": "18.1.1",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "simple-icons": "16.35.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
